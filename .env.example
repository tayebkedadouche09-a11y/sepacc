# =============================================================================
# NUMI — Environment Configuration (ONLY file you must edit)
# Copy to .env and fill real values. Never commit .env.
# =============================================================================

# --- Core (required to boot marketplace + auth) ---
DATABASE_URL=postgresql://user:password@host:5432/numi
PUBLIC_APP_URL=https://your-domain.com
JWT_SECRET=generate-a-long-random-string-at-least-32-chars
OAUTH_SERVER_URL=
VITE_APP_ID=
# Your OAuth subject/open-id — ONLY this account becomes admin (owner panel)
OWNER_OPEN_ID=

PORT=3000

# --- Payments (configure at least one for live sales) ---
STRIPE_SECRET_KEY=
VITE_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

CHARGILY_SECRET_KEY=
CHARGILY_API_URL=https://pay.chargily.net/api/v2

PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_API_URL=https://api-m.paypal.com
PAYPAL_WEBHOOK_ID=

# --- Native customer delivery (GitHub private repo + Vercel) ---
GITHUB_TOKEN=
GITHUB_OWNER=
GITHUB_API_URL=https://api.github.com

VERCEL_TOKEN=
VERCEL_TEAM_ID=
VERCEL_API_URL=https://api.vercel.com

# --- Optional: external provisioning worker ---
PROVISIONING_API_URL=
PROVISIONING_API_KEY=
AUTOMATION_WORKER_SECRET=

# --- Customer database provisioning ---
CUSTOMER_DB_PROVIDER=none
NEON_API_KEY=
NEON_ORG_ID=
NEON_PROJECT_ID=
SUPABASE_ACCESS_TOKEN=
SUPABASE_ORG_ID=
PLANETSCALE_SERVICE_TOKEN=
PLANETSCALE_SERVICE_TOKEN_ID=
PLANETSCALE_ORG=

# --- Secrets encryption (optional, recommended in production) ---
SECRETS_ENCRYPTION_KEY=

# --- Email / notifications ---
EMAIL_PROVIDER=none
EMAIL_FROM=noreply@your-domain.com
RESEND_API_KEY=
POSTMARK_SERVER_TOKEN=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# --- Object storage ---
STORAGE_PROVIDER=none
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=

# --- AI ---
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=

# --- Monitoring ---
MONITORING_WEBHOOK_URL=
BACKUP_WEBHOOK_URL=
SENTRY_DSN=

# --- Feature toggles ---
FEATURE_NATIVE_PROVISIONING=true
FEATURE_CHARGILY=true
FEATURE_AI_FAQ=true
